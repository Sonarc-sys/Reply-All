[ext_resource type="Script" uid="uid://bsi7vk31tp6eg" path="res://resources/Issue.gd" id="1_iss"]
[ext_resource type="Resource" path="res://resources/Escalation Resources/WeakCredentials.tres" id="1_wc"]

[resource]
script = ExtResource("1_iss")
issue_name = "Weak Password"
description = "An employee is using 'password123' as their login. What is the correct action?"
employee_message = "IT flagged my account in the audit.
Apparently my password is too simple?

Can you just leave it, it's easy to remember."
threat_level = 2
urgency = 0.2
escalation = ExtResource("1_wc")
correct_index = 1
answers = Array[String](["Leave it  -  the employee asked you to", "Enforce a password reset via policy", "Delete their account"])
explanation = "Weak passwords are a top attack vector. Enforce a reset  -  user preference doesn't override security policy."
metadata/_custom_type_script = "uid://bsi7vk31tp6eg"
