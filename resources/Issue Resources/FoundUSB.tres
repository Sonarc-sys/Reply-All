[ext_resource type="Script" path="res://resources/Issue.gd" id="1_ek173"]

[resource]
script = ExtResource("1_ek173")
issue_name = "Suspicious USB"
description = "An employee plugged in an unkown flash drive found in the parking lot."
employee_message = "I just found this amazing 64GB drive outside! I plugged it in to see who it belongs to, but nothing showed up. Can you please check it?"
threat_level = 3
urgency = 0.6
score = 150
answers = Array[String](["Issue Password Reset Ticket", "Send them Home", "Destroy Computer"])
explanation = "Removable media drops are a classic physical vector for malicious payloads. The device must be isolated and scanned immediately."
metadata/_custom_type_script = "uid://bsi7vk31tp6eg"
