[ext_resource type="Script" uid="uid://bsi7vk31tp6eg" path="res://resources/Issue.gd" id="1_iss"]

[resource]
script = ExtResource("1_iss")
issue_name = "Credential Database Dump"
description = "An alert confirms the employee database including hashed passwords has been exfiltrated. Attackers may begin cracking passwords immediately."
employee_message = "Someone from HR just messaged me asking me to confirm
my login details for a 'security audit.'
Is that normal?"
threat_level = 5
urgency = 0.35
escalation = ExtResource("1_esc")
correct_index = 2
answers = Array[String](["Confirm the details  -  HR has authority", "Ignore the message", "Refuse and immediately report to IT security  -  this is phishing"])
explanation = "HR will never ask for your login credentials. This is a social engineering attack. Report it immediately and force a company-wide password reset."
