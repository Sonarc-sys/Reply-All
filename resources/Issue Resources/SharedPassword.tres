[gd_resource type="Resource" script_class="CyberIssue" format=3]
[ext_resource type="Script" path="res://resources/Issue.gd" id="1_iss"]
[resource]
script = ExtResource("1_iss")
issue_name = "Shared Account Password"
description = "Two employees have been sharing one login account to avoid asking IT for a second licence."
employee_message = "Me and Jake have been sharing my login\nfor the accounting software for months.\nIs that a problem?"
threat_level = 2
urgency = 0.2
correct_index = 2
answers = Array[String](["It is fine if they trust each other", "Ask them to take turns", "Immediately provision separate accounts and disable the shared login"])
explanation = "Shared accounts make audit trails useless and violate least-privilege principles. Each user must have their own credentials."
