[resource]
script = ExtResource("1_qu055")
issue_name = "Expose Password"
description = "An employee wrote their system password on a sticky note attached to their monitor."
employee_message = "I have to change my password each 30 days, there's no way I can memorize all of these passwords."
urgency = 0.2
score = 50
answers = Array[String](["Issue Password Reset Ticket", "Send them Home", "Destroy Computer"])
explanation = "Physical security is as important as digital security. Passwords must never be written down and left in plain sight."
