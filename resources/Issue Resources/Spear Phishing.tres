[gd_resource type="Resource" script_class="CyberIssue" format=3]

[ext_resource type="Script" path="res://resources/Issue.gd" id="1_kkexw"]

[resource]
script = ExtResource("1_kkexw")
issue_name = "Fake Vendor Invoice"
description = "An email that has a PDF attachement claiming to be an overdue invoice from a known vendor."
employee_message = "I just got an invoice from our catering vendor, but the email address looks misspelled and strange. Should I open it and pay the invoice?"
threat_level = 4
urgency = 0.35
score = 200
answers = Array[String](["Issue Password Reset Ticket", "Send them Home", "Destroy Computer"])
explanation = "Targeted spear-phishing requires careful verification of sender addresses and domains before interacting with attachments."
metadata/_custom_type_script = "uid://bsi7vk31tp6eg"
