[ext_resource type="Script" path="res://resources/Issue.gd" id="1_rxhjm"]

[resource]
script = ExtResource("1_rxhjm")
issue_name = "The Reply-All Storm"
description = "An employee clicked on a link accidentally that then hijacked their email client to email a malicious link to all of the company's employees using the company's directory."
employee_message = "Hey, so I clicked on the link for a free gift card, and now my Outlook is sending thousands of emails to all of the company's contacts all on it's own."
threat_level = 5
urgency = 0.9
escalation = ExtResource("1_mwxv4")
score = 450
answers = Array[String](["Issue Password Reset Ticket", "Send them Home", "Destroy Computer"])
explanation = "A self-propagating email worm will paralyze the mail server, and then at the same time compromise anyone else who will click on it.

"
